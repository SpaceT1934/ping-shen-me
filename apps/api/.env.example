NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
DATA_DRIVER=pglite
PGLITE_DATA_DIR=./.data/apple
# 独立 PostgreSQL 模式：将 DATA_DRIVER 改为 postgres，并配置下面的连接地址。
# 与 infra/compose.yaml 的本地开发数据库一致；生产环境使用独立凭证。
DATABASE_URL=postgresql://apple:apple_local_dev@localhost:5432/apple
